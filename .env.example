# Required
DISCORD_TOKEN=replace_with_your_bot_token

# Optional integrations
STEAMGRIDDB_API_KEY=replace_with_your_steamgriddb_api_key
IGDB_CLIENT_ID=replace_with_your_igdb_client_id
IGDB_CLIENT_SECRET=replace_with_your_igdb_client_secret

# Optional: values here override config.json
# SUGGESTION_THREAD_ID=123456789012345678
# DISPLAY_TIMEZONE_OFFSET=+10:00
# STEAM_COUNTRY_CODE=AU
# STEAM_LANGUAGE=english
# STORE_ACCEPT_LANGUAGE=en-AU,en;q=0.9
# EPIC_STORE_LOCALE=en-AU
# STEAM_EMOJI=<:Steam:123456789012345678>
# EPIC_EMOJI=<:EpicGames:123456789012345678>
