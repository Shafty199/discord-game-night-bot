# Required
DISCORD_TOKEN=replace_with_your_bot_token

# Optional metadata and artwork integrations
STEAMGRIDDB_API_KEY=replace_with_your_steamgriddb_api_key
IGDB_CLIENT_ID=replace_with_your_igdb_client_id
IGDB_CLIENT_SECRET=replace_with_your_igdb_client_secret

# Optional pre-rendered wheel cache in Oracle Cloud Object Storage.
# OCI compute instances may authenticate through a dynamic group.
# OCI_SPIN_NAMESPACE=replace_with_your_object_storage_namespace
# OCI_SPIN_BUCKET=replace_with_your_bucket_name
# OCI_SPIN_REGION=replace_with_your_oci_region
# SPIN_CACHE_CHANNEL_ID=123456789012345678

# Session controls, optional notification role and maintenance log channel.
# SESSION_CHANNEL_ID=123456789012345678
# SESSION_NOTIFY_ROLE_ID=123456789012345678
# LOGGING_CHANNEL_ID=123456789012345678

# Weekly poll, one-off Discord event and timed reminders.
# GAME_NIGHT_CHANNEL_ID=123456789012345678
# GAME_NIGHT_ROLE_ID=123456789012345678
# GAME_NIGHT_VOICE_CHANNEL_ID=123456789012345678
# GAME_NIGHT_TIMEZONE=UTC

# Optional values here override config.json.
# SUGGESTION_THREAD_ID=123456789012345678
# DISPLAY_TIMEZONE_OFFSET=+00:00
# STEAM_COUNTRY_CODE=US
# STEAM_LANGUAGE=english
# STORE_ACCEPT_LANGUAGE=en-US,en;q=0.9
# EPIC_STORE_LOCALE=en-US
# STEAM_EMOJI=<:Steam:123456789012345678>
# EPIC_EMOJI=<:EpicGames:123456789012345678>
